#!/bin/sh
# Refuse a commit when staged web JS doesn't parse or the engine rules fail.
# A push to Web-Port deploys the live site, so this is the last cheap safety net.
# Enable once per clone: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

staged_js=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '^web/.*\.js$' || true)
if [ -n "$staged_js" ]; then
    echo "pre-commit: checking JS syntax"
    for f in $staged_js; do
        node --check "$f"
    done
fi

if git diff --cached --name-only | grep -qE '^src/prismata/'; then
    echo "pre-commit: running engine checks"
    python tests/engine_checks.py --quick
fi
