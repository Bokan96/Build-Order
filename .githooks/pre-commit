#!/bin/sh
# Refuse a commit when the web JS doesn't parse or the engine rules fail.
# A push to Web-Port deploys the live site, so this is the last cheap safety net.
# Enable once per clone: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

if git diff --cached --name-only | grep -qE '^web/.*\.js$'; then
    echo "pre-commit: checking JS syntax"
    node --check web/app.js
    node --check web/multiplayer.js
fi

if git diff --cached --name-only | grep -qE '^src/prismata/'; then
    echo "pre-commit: running engine checks"
    python tests/engine_checks.py --quick
fi
